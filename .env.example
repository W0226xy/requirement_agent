APP_ENV=development
APP_NAME=Requirement Agent API
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=requirement_agent
POSTGRES_USER=requirement_agent
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+asyncpg://requirement_agent:change-me-for-local-development@postgres:5432/requirement_agent

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=requirement-agent
MINIO_SECRET_KEY=change-me-for-local-development
MINIO_BUCKET=requirement-agent
MINIO_SECURE=false
MAX_UPLOAD_SIZE_BYTES=52428800

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT_SECONDS=10

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-chat-model
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_DIMENSION=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

RETRIEVAL_KEYWORD_WEIGHT=0.4
RETRIEVAL_VECTOR_WEIGHT=0.4
RETRIEVAL_BUSINESS_WEIGHT=0.2
RETRIEVAL_CANDIDATE_LIMIT=20
CONVERSATION_CONTEXT_MESSAGE_LIMIT=8
CONVERSATION_CONTEXT_CHAR_LIMIT=6000
CONVERSATION_MEMORY_SUMMARY_LIMIT=2000

VITE_API_PROXY_TARGET=http://api:8000
